# @angular-devkit/build-angular@18 declares an optional peer on jest@^29
# (its own unused experimental Jest builder support), which conflicts with
# our real jest@^30 used for actual test wiring. That peer is optional and
# irrelevant here, so this is safe to relax. Without this pinned explicitly,
# plain `npm ci` resolves it differently across npm versions - it passed
# locally on npm 11 but failed with ERESOLVE in CI on npm 10 (Node 20).
legacy-peer-deps=true
