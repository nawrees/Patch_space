# Copy this to .env in the same directory as docker-compose.yml, on the VM
# — never commit the real .env. Two consumers read this one file:
#   - backend's container gets every var here injected directly via
#     docker-compose.yml's `env_file: .env`
#   - docker compose itself substitutes ${SUPABASE_URL} etc. into the
#     frontend build's `args:` from this same file — no separate copy needed

NODE_ENV=production
PORT=4000

# Supabase project settings (Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
# NEVER expose this one to the frontend — backend container only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# The frontend's real public origin (no TLS/domain yet, so this is
# http://<vm-ip> for now). The frontend's own calls to the backend go
# through nginx's same-origin /api proxy (see frontend/nginx.conf), so this
# mostly matters for anything hitting the backend directly rather than
# through the proxied frontend (e.g. testing with curl/Postman).
CORS_ORIGIN=http://your-vm-ip-or-domain

# Public hostname/IP students' browsers use to reach a running lab
# container. Defaults to "localhost" in the backend if unset — WRONG here,
# that would tell students to connect to their own machine instead of the
# VM. Set this to the same host as CORS_ORIGIN above.
LAB_HOST=your-vm-ip-or-domain

# Must match the private Storage bucket you created for PDF/lesson resources
LESSON_RESOURCES_BUCKET=lesson-resources

# Max simultaneous lab containers one student can have running across all labs
LAB_MAX_CONCURRENT_PER_STUDENT=2
# Max simultaneous lab containers across the whole platform (protects host resources)
LAB_MAX_CONCURRENT_TOTAL=15
