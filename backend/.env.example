NODE_ENV=development
PORT=4000

# Supabase project settings (Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
# NEVER expose this key to the frontend — backend only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Angular dev server origin, for CORS
CORS_ORIGIN=http://localhost:4200

# Must match the private Storage bucket you created for PDF/lesson resources
LESSON_RESOURCES_BUCKET=lesson-resources

# Max simultaneous lab containers one student can have running across all labs
LAB_MAX_CONCURRENT_PER_STUDENT=2
# Max simultaneous lab containers across the whole platform (protects host resources)
LAB_MAX_CONCURRENT_TOTAL=15

# Public hostname/IP students' browsers use to reach a running lab container.
# Defaults to "localhost" if unset — fine for local dev, but WRONG on a real
# server: lab access URLs would tell students to connect to their own
# machine instead of the VM. Set this to the VM's public IP or domain.
LAB_HOST=localhost

