# Dummy values so tests can import controllers (env.js throws if these are
# missing) without needing real credentials — nothing here ever talks to a
# real Supabase project. Safe to commit: no real secrets.
SUPABASE_URL=https://dummy-test-project.supabase.co
SUPABASE_ANON_KEY=dummy-anon-key-for-tests-only
SUPABASE_SERVICE_ROLE_KEY=dummy-service-role-key-for-tests-only
